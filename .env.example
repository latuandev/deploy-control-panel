# Shared
POSTGRES_DB=deploy_panel
POSTGRES_USER=deploy_panel
POSTGRES_PASSWORD=change-me

# Backend
DJANGO_SECRET_KEY=change-me-use-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Production reverse proxy example:
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1,backend
# CORS_ALLOWED_ORIGINS=https://example.com
# CSRF_TRUSTED_ORIGINS=https://example.com,https://api.example.com
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Target AlmaLinux server
TARGET_SSH_HOST=203.0.113.10
TARGET_SSH_PORT=22
TARGET_SSH_USER=tuanle
TARGET_SSH_KEY_PATH=/run/secrets/deploy_panel_key
TARGET_SSH_KEY_PASSPHRASE=
TARGET_SSH_KNOWN_HOSTS=
TARGET_REMOTE_RUNNER=/opt/apps/scripts/run-deploy-job.sh
TARGET_REMOTE_LOG_DIR=/home/tuanle/logs/deploy

# Development convenience only. Prefer false with TARGET_SSH_KNOWN_HOSTS set in production.
SSH_AUTO_ADD_HOST_KEY=true

FRONTEND_PORT=3000
BACKEND_PORT=8000
